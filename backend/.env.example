# Copy to `.env` and fill in values:  cp .env.example .env
#
# Locally this file drives `serverless-offline` (it is loaded by
# `useDotenv: true` in serverless.yml). In CI the same names must exist as
# GitHub Actions secrets/variables or the deploy would ship empty strings —
# every `${env:X, 'default'}` reference below silently falls back.

# --- Database ---------------------------------------------------------------
# MongoDB Atlas connection string. Atlas network access must allow the caller:
# 0.0.0.0/0 (or a PrivateLink/VPC setup) for deployed Lambda functions.
MONGODB_URI=

# --- AWS --------------------------------------------------------------------
# Region the Lambda functions are deployed to.
AWS_REGION=ap-southeast-1
# Deployment stage; the API Gateway path prefix is /<STAGE>.
STAGE=dev
# Do NOT put long-lived keys here for CI. Local runs use your ~/.aws profile,
# and CI assumes a role via GitHub OIDC (secret: AWS_DEPLOY_ROLE_ARN).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Media uploads (S3 presigned URLs, see src/shared/s3.ts) ----------------
S3_BUCKET_NAME=kabarangayconnect-media
S3_BUCKET_REGION=ap-southeast-1

# --- Session JWT ------------------------------------------------------------
# Sign/verify key for the httpOnly `kbc_token` cookie. Use a long random value.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional dedicated signing key for the resident Google SSO `state` value.
# Leave empty to fall back to JWT_SECRET (see src/shared/oauth-state.ts).
OAUTH_STATE_SECRET=

# --- Admin MFA (legacy custom TOTP; Cognito is the active path) ------------
TOTP_ISSUER=KaBarangayConnect
# AES-256 key (32 bytes hex) used to encrypt the TOTP secret at rest.
# Generate with: openssl rand -hex 32
TOTP_SECRET_ENCRYPTION_KEY=
TOTP_ENROLLMENT_JWT_TTL=10m

# --- Admin auth: AWS Cognito User Pool (software-token TOTP) ---------------
# Without the pool id + client id, deployed Lambdas cannot reach Cognito and
# admin login fails closed. See docs/COGNITO_AWS_CONSOLE.md.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-southeast-1
# `true` verifies admin passwords against Mongo and accepts dev TOTP 123456.
# Never enable this in a deployed environment.
COGNITO_OFFLINE=true
# Initial password used by `npm run provision:cognito` for seed admins.
COGNITO_PROVISION_PASSWORD=

# --- Resident Google SSO ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the backend's /<STAGE>/auth/resident/google/callback route AND be
# registered as an authorized redirect URI on the Google OAuth client.
# Local:
GOOGLE_REDIRECT_URI=http://localhost:3000/dev/auth/resident/google/callback
# Deployed:
# GOOGLE_REDIRECT_URI=https://<api-id>.execute-api.<region>.amazonaws.com/dev/auth/resident/google/callback
