# Copy to `.env` and adjust as needed. These are read by `next.config.ts`.

# Base URL of the serverless REST backend.
API_BACKEND_URL=http://localhost:3000

# Stage prefix used by `serverless offline` (e.g. `/dev`).
API_BACKEND_STAGE=dev

# Base URL of the backend WebSocket server. Read by `next.config.ts`.
# Must match `custom.serverless-offline.websocketPort` in backend/serverless.yml
# (npm --prefix backend run verify:routes fails on a mismatch). Port 3002 is
# serverless-offline's lambdaPort (HTTP Lambda invoke), not the WS port.
API_WEBSOCKET_URL=ws://localhost:3001

# WebSocket URL consumed by the client hook (`src/hooks/useWebSocket.ts`).
# Must be NEXT_PUBLIC_* to be visible in the browser bundle.
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3001

# --- Session cookie (`kbc_token`) ---

# Cookie Max-Age in seconds. Keep in step with the backend's JWT_EXPIRES_IN,
# otherwise the cookie outlives the token it wraps.
SESSION_COOKIE_MAX_AGE_SECONDS=604800

# Force the cookie's `Secure` attribute (true/false). Leave unset for the
# default (Secure when NODE_ENV=production). Set to `false` to test over plain
# HTTP, e.g. http://<LAN-IP>:8000 — browsers silently DROP a Secure cookie
# there, so login appears to succeed and the next request looks logged out.
# COOKIE_SECURE=false